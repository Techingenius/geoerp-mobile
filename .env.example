# Which backend the app talks to. There is no staging Supabase project yet, so
# a local geoerp stack (`supabase start` in ../geoerp) is the only non-production
# target — see docs/mobile-delivery-contract.md.
#
# A device or emulator cannot reach 127.0.0.1: use the host's LAN address.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Set by the `qa` EAS build profile; unset locally and for `preview` builds.
# Anything other than `staging` means the binary is talking to production data.
# EXPO_PUBLIC_BACKEND_ENV=staging
